{
    "cSpell.words": [
        "blackmesa",
        "daysstodie",
        "daystodie",
        "freeplay",
        "gamesvr",
        "laclede",
        "laclede's",
        "laclede’s",
        "lacledeslan",
        "reindex",
        "steamcmd",
        "tf2",
        "trixie"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "markdownlint.lintWorkspaceGlobs": [
        "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
        "!**/*.code-search",
        "!**/bower_components",
        "!**/node_modules",
        "!**/.git",
        "!**/vendor",
        "!LICENSE",
        "!repos/**"
    ],
    "shellcheck.exclude": ["1091"],
    "search.exclude": {
        "**/.git": true,
        "**/repos/**": true
    },
    "terminal.integrated.scrollback": 6000,
    "[markdown]": {
        "cSpell.fixSpellingWithRenameProvider": true,
        "cSpell.advanced.feature.useReferenceProviderWithRename": true,
        "cSpell.advanced.feature.useReferenceProviderRemove": "/^#+\\s/",
        "editor.rulers": [120],
        "editor.unicodeHighlight.ambiguousCharacters": true,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.wordWrap": "on"
    },
    "[shellscript]": {
        "editor.rulers": [100],
        "files.eol": "\n"
    }
}
